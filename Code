import argparse
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader, TensorDataset
from torchvision.utils import save_image
from medmnist import PneumoniaMNIST

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
SIZE = 64
LATENT = 128
NUM_CLASSES = 2  # 0 = normal, 1 = pneumonia
CKPT = "cvae.pt"

torch.manual_seed(0)


# ----------------------------------------------------------------- data
def load_split(split):
    ds = PneumoniaMNIST(split=split, download=True, size=SIZE)
    x = torch.tensor(ds.imgs, dtype=torch.float32).unsqueeze(1) / 255.0  # (N,1,64,64) in [0,1]
    y = torch.tensor(ds.labels, dtype=torch.long).view(-1)
    return x, y


# ---------------------------------------------------------------- model
class CVAE(nn.Module):
    def __init__(self, latent=LATENT, n_classes=NUM_CLASSES):
        super().__init__()
        self.n_classes = n_classes
        # Encoder: image + label maps (as extra channels) -> mu, logvar
        self.enc = nn.Sequential(
            nn.Conv2d(1 + n_classes, 32, 4, 2, 1), nn.ReLU(),   # 32x32
            nn.Conv2d(32, 64, 4, 2, 1), nn.BatchNorm2d(64), nn.ReLU(),   # 16x16
            nn.Conv2d(64, 128, 4, 2, 1), nn.BatchNorm2d(128), nn.ReLU(), # 8x8
            nn.Conv2d(128, 256, 4, 2, 1), nn.BatchNorm2d(256), nn.ReLU(),# 4x4
            nn.Flatten(),
        )
        self.fc_mu = nn.Linear(256 * 4 * 4, latent)
        self.fc_logvar = nn.Linear(256 * 4 * 4, latent)
        # Decoder: z + one-hot label -> image
        self.dec_fc = nn.Linear(latent + n_classes, 256 * 4 * 4)
        self.dec = nn.Sequential(
            nn.ConvTranspose2d(256, 128, 4, 2, 1), nn.BatchNorm2d(128), nn.ReLU(),  # 8
            nn.ConvTranspose2d(128, 64, 4, 2, 1), nn.BatchNorm2d(64), nn.ReLU(),    # 16
            nn.ConvTranspose2d(64, 32, 4, 2, 1), nn.BatchNorm2d(32), nn.ReLU(),     # 32
            nn.ConvTranspose2d(32, 1, 4, 2, 1), nn.Sigmoid(),                       # 64
        )

    def encode(self, x, y):
        onehot = F.one_hot(y, self.n_classes).float()
        maps = onehot[:, :, None, None].expand(-1, -1, x.size(2), x.size(3))
        h = self.enc(torch.cat([x, maps], dim=1))
        return self.fc_mu(h), self.fc_logvar(h)

    def decode(self, z, y):
        onehot = F.one_hot(y, self.n_classes).float()
        h = self.dec_fc(torch.cat([z, onehot], dim=1)).view(-1, 256, 4, 4)
        return self.dec(h)

    def forward(self, x, y):
        mu, logvar = self.encode(x, y)
        z = mu + torch.randn_like(mu) * torch.exp(0.5 * logvar)
        return self.decode(z, y), mu, logvar

    @torch.no_grad()
    def sample(self, n, label):
        self.eval()
        z = torch.randn(n, LATENT, device=DEVICE)
        y = torch.full((n,), label, dtype=torch.long, device=DEVICE)
        return self.decode(z, y).cpu()


def vae_loss(recon, x, mu, logvar, beta=1.0):
    rec = F.binary_cross_entropy(recon, x, reduction="sum") / x.size(0)
    kl = -0.5 * torch.sum(1 + logvar - mu.pow(2) - logvar.exp()) / x.size(0)
    return rec + beta * kl, rec, kl


# ---------------------------------------------------------------- train
def train(epochs, batch_size=128, lr=1e-3, beta=1.0):
    x, y = load_split("train")
    loader = DataLoader(TensorDataset(x, y), batch_size=batch_size, shuffle=True)
    model = CVAE().to(DEVICE)
    opt = torch.optim.Adam(model.parameters(), lr=lr)

    for ep in range(1, epochs + 1):
        model.train()
        tot = rec_t = kl_t = 0.0
        for xb, yb in loader:
            xb, yb = xb.to(DEVICE), yb.to(DEVICE)
            recon, mu, logvar = model(xb, yb)
            loss, rec, kl = vae_loss(recon, xb, mu, logvar, beta)
            opt.zero_grad()
            loss.backward()
            opt.step()
            n = xb.size(0)
            tot += loss.item() * n
            rec_t += rec.item() * n
            kl_t += kl.item() * n
        N = len(x)
        print(f"Epoch {ep:3d} | loss {tot/N:.2f} | recon {rec_t/N:.2f} | KL {kl_t/N:.2f}")
        if ep % 10 == 0 or ep == epochs:
            for c in range(NUM_CLASSES):
                save_image(model.sample(64, c), f"samples_class{c}_ep{ep}.png", nrow=8)
    torch.save(model.state_dict(), CKPT)
    print(f"Saved {CKPT}")


def load_model():
    model = CVAE().to(DEVICE)
    model.load_state_dict(torch.load(CKPT, map_location=DEVICE))
    model.eval()
    return model


# ------------------------------------------------------------- generate
def generate():
    model = load_model()
    names = {0: "normal", 1: "pneumonia"}
    for c in range(NUM_CLASSES):
        save_image(model.sample(64, c), f"generated_{names[c]}.png", nrow=8)
        print(f"Saved generated_{names[c]}.png")

    # Latent interpolation between two samples of the same class (nice demo figure)
    with torch.no_grad():
        z1, z2 = torch.randn(1, LATENT, device=DEVICE), torch.randn(1, LATENT, device=DEVICE)
        steps = torch.linspace(0, 1, 10, device=DEVICE).view(-1, 1)
        z = (1 - steps) * z1 + steps * z2
        y = torch.ones(10, dtype=torch.long, device=DEVICE)
        save_image(model.decode(z, y).cpu(), "interpolation.png", nrow=10)
        print("Saved interpolation.png")


# ------------------------------------------------------------- evaluate
class SmallCNN(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(
            nn.Conv2d(1, 32, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2),
            nn.Conv2d(32, 64, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2),
            nn.Conv2d(64, 128, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2),
            nn.Flatten(), nn.Dropout(0.3), nn.Linear(128 * 8 * 8, 2),
        )

    def forward(self, x):
        return self.net(x)


def train_classifier(x, y, x_test, y_test, epochs=10):
    model = SmallCNN().to(DEVICE)
    opt = torch.optim.Adam(model.parameters(), lr=1e-3)
    loader = DataLoader(TensorDataset(x, y), batch_size=128, shuffle=True)
    for _ in range(epochs):
        model.train()
        for xb, yb in loader:
            xb, yb = xb.to(DEVICE), yb.to(DEVICE)
            loss = F.cross_entropy(model(xb), yb)
            opt.zero_grad()
            loss.backward()
            opt.step()

    model.eval()
    with torch.no_grad():
        preds = torch.cat([model(xb.to(DEVICE)).argmax(1).cpu()
                           for xb in torch.split(x_test, 256)])
    acc = (preds == y_test).float().mean().item()
    recalls = []
    for c in range(NUM_CLASSES):
        mask = y_test == c
        recalls.append((preds[mask] == c).float().mean().item())
    return acc, recalls, sum(recalls) / len(recalls)


def evaluate():
    x, y = load_split("train")
    x_test, y_test = load_split("test")
    counts = torch.bincount(y, minlength=NUM_CLASSES)
    print("Train class counts:", counts.tolist())

    print("\n[1] Classifier on REAL data only")
    acc, rec, bacc = train_classifier(x, y, x_test, y_test)
    print(f"Accuracy {acc:.3f} | recall normal {rec[0]:.3f}, pneumonia {rec[1]:.3f} | balanced acc {bacc:.3f}")

    # Generate synthetic images to balance the minority class
    model = load_model()
    minority = int(counts.argmin())
    n_needed = int(counts.max() - counts.min())
    syn_x = torch.cat([model.sample(min(1000, n_needed - i), minority)
                       for i in range(0, n_needed, 1000)])
    syn_y = torch.full((len(syn_x),), minority, dtype=torch.long)
    print(f"\nGenerated {len(syn_x)} synthetic images for class {minority}")

    print("\n[2] Classifier on REAL + SYNTHETIC (balanced)")
    acc2, rec2, bacc2 = train_classifier(torch.cat([x, syn_x]), torch.cat([y, syn_y]), x_test, y_test)
    print(f"Accuracy {acc2:.3f} | recall normal {rec2[0]:.3f}, pneumonia {rec2[1]:.3f} | balanced acc {bacc2:.3f}")

    print("\nSummary (balanced accuracy): real {:.3f} -> real+synthetic {:.3f}".format(bacc, bacc2))


# ----------------------------------------------------------------- main
if __name__ == "__main__":
    p = argparse.ArgumentParser()
    p.add_argument("mode", choices=["train", "generate", "evaluate"])
    p.add_argument("--epochs", type=int, default=40)
    p.add_argument("--beta", type=float, default=1.0, help="KL weight (try 0.5-2)")
    a = p.parse_args()
    {"train": lambda: train(a.epochs, beta=a.beta),
     "generate": generate,
     "evaluate": evaluate}[a.mode]()
